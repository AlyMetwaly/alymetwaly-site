---
import { executive } from "../../config/executive";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const { insights: insightsConfig } = executive;

const all = await getCollection("insights");
const published = all
  .filter((e) => (import.meta.env.PROD ? !e.data.draft : true))
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const byCategory = insightsConfig.categories.map((cat) => ({
  ...cat,
  items: published.filter((e) => e.data.category === cat.label),
}));
---

<BaseLayout
  title={insightsConfig.meta.title}
  description={insightsConfig.meta.description}
  landing
>
  <div class="exec-landing insights-hub">
    <!-- 1. Title + positioning -->
    <section class="exec-section exec-hero insights-opening" aria-labelledby="insights-title">
      <div class="kicker reveal-on-scroll">
        <span class="kicker-dot"></span>
        {insightsConfig.kicker}
      </div>

      <h1 id="insights-title" class="reveal-on-scroll">{insightsConfig.title}</h1>

      {
        insightsConfig.intro.lines.map((line, i) => (
          <p class:list={["reveal-on-scroll", i === 0 && "exec-lead"]}>{line}</p>
        ))
      }
    </section>

    <!-- 2. Content categories + article cards -->
    {
      byCategory.map((category) => (
        <section
          class="exec-section insights-category"
          aria-labelledby={`insights-cat-${category.id}`}
        >
          <h2 id={`insights-cat-${category.id}`} class="insights-category-heading reveal-on-scroll">
            {category.label}
          </h2>

          <p class="insights-category-definition reveal-on-scroll">{category.definition}</p>

          {
            category.items.length > 0 ? (
              <ul class="insight-card-grid">
                {category.items.map((entry) => (
                  <li class="reveal-on-scroll">
                    <a class="insight-card" href={`/insights/${entry.slug}`}>
                      <span class="insight-card-category">{entry.data.category}</span>
                      <h3 class="insight-card-title">{entry.data.title}</h3>
                      <p class="insight-card-preview">{entry.data.preview}</p>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="insights-empty reveal-on-scroll">No insights in this category yet.</p>
            )
          }
        </section>
      ))
    }

    <section class="exec-section insights-footer" aria-label="Next steps">
      <p class="insights-footer-lead reveal-on-scroll">
        For operating model design, executive advisory, and leadership sessions—see engagements.
      </p>

      <div class="actions reveal-on-scroll">
        <a class="button primary" href="/engagements">Discuss AI transformation</a>
        <a class="button" href="/work">View case studies</a>
      </div>
    </section>
  </div>
</BaseLayout>
