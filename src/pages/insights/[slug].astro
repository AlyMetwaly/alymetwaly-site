---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("insights");
  const published = entries.filter((e) => (import.meta.env.PROD ? !e.data.draft : true));
  return published.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="article">
    {entry.data.pubDate ? (
      <div class="kicker reveal-on-scroll">
        <span class="kicker-dot"></span>
        <time datetime={entry.data.pubDate.toISOString()}>
          {entry.data.pubDate.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </time>
      </div>
    ) : null}

    <h1 class="reveal-on-scroll">{entry.data.title}</h1>

    <div class="reveal-on-scroll">
      <Content />
    </div>

    <div class="actions reveal-on-scroll">
      <a class="button primary" href="/insights">More insights</a>
      <a class="button" href="/engagements">Engagements</a>
    </div>
  </article>
</BaseLayout>
