---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const all = await getCollection("insights");
const items = all
  .filter((e) => (import.meta.env.PROD ? !e.data.draft : true))
  .sort((a, b) => {
    const ad = a.data.pubDate ? a.data.pubDate.getTime() : 0;
    const bd = b.data.pubDate ? b.data.pubDate.getTime() : 0;
    return bd - ad;
  });
---

<BaseLayout title="Insights">
  <h1>Insights</h1>
  <p>Essays and frameworks on AI adoption, enablement, and transformation.</p>

  <ul>
    {items.map((e) => (
      <li>
        <a href={`/insights/${e.slug}`}>{e.data.title}</a>
        {e.data.description && <p>{e.data.description}</p>}
      </li>
    ))}
  </ul>
</BaseLayout>
``