---
import { executive } from "../config/executive";
import BaseLayout from "../layouts/BaseLayout.astro";

const { philosophy } = executive;
---

<BaseLayout title={philosophy.meta.title} description={philosophy.meta.description} landing>
  <div class="exec-landing philosophy-doc">
    <section class="exec-section exec-hero philosophy-opening" aria-labelledby="philosophy-title">
      <div class="kicker reveal-on-scroll">
        <span class="kicker-dot"></span>
        {philosophy.kicker}
      </div>

      <h1 id="philosophy-title" class="reveal-on-scroll">{philosophy.title}</h1>

      {
        philosophy.intro.lines.map((line, i) => (
          <p class:list={["reveal-on-scroll", i === 0 && "exec-lead"]}>{line}</p>
        ))
      }
    </section>

    <section class="exec-section" aria-labelledby="philosophy-principles">
      <h2 id="philosophy-principles" class="visually-hidden">Principles</h2>

      <ul class="philosophy-principles">
        {
          philosophy.principles.map(({ label, statement, implication }) => (
            <li class="philosophy-principle reveal-on-scroll">
              <h3 class="philosophy-principle-label">{label}</h3>
              <p class="philosophy-principle-statement">{statement}</p>
              {implication && <p class="philosophy-principle-implication">{implication}</p>}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="exec-section philosophy-execution" aria-labelledby="philosophy-execution">
      <h2 id="philosophy-execution" class="exec-inline-heading reveal-on-scroll">
        {philosophy.execution.heading}
      </h2>
      <p class="philosophy-execution-body reveal-on-scroll">{philosophy.execution.body}</p>
    </section>
  </div>
</BaseLayout>
