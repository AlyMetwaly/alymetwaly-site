---
import { executive } from "../config/executive";
import BaseLayout from "../layouts/BaseLayout.astro";

const { about } = executive;
---

<BaseLayout title={about.meta.title} description={about.meta.description} landing>
  <div class="exec-landing about-doc">
  <!-- 1. Opening statement -->
  <section class="exec-section exec-hero about-opening" aria-labelledby="about-opening">
    <div class="kicker reveal-on-scroll">
      <span class="kicker-dot"></span>
      {about.kicker} · {executive.regions}
    </div>

    <h1 id="about-opening" class="reveal-on-scroll">{executive.name}</h1>

    {
      about.opening.lines.map((line, i) => (
        <p class:list={["reveal-on-scroll", i === 0 && "exec-lead"]}>{line}</p>
      ))
    }
  </section>

  <!-- 2. What I actually do -->
  <section class="exec-section" aria-labelledby="about-what-i-do">
    <h2 id="about-what-i-do" class="exec-inline-heading reveal-on-scroll">
      {about.whatIDo.heading}
    </h2>

    <p class="about-lead reveal-on-scroll">{about.whatIDo.lead}</p>

    <ul class="exec-bullets">
      {
        about.whatIDo.points.map((point) => (
          <li class="reveal-on-scroll">{point}</li>
        ))
      }
    </ul>
  </section>

  <!-- 3. How I think about AI transformation -->
  <section class="exec-section" aria-labelledby="about-transformation">
    <h2 id="about-transformation" class="exec-inline-heading reveal-on-scroll">
      {about.transformation.heading}
    </h2>

    <ul class="about-contrasts">
      {
        about.transformation.contrasts.map(({ label, body }) => (
          <li class="reveal-on-scroll">
            <h3 class="about-contrast-label">{label}</h3>
            <p>{body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 4. What makes me different -->
  <section class="exec-section" aria-labelledby="about-different">
    <h2 id="about-different" class="exec-inline-heading reveal-on-scroll">
      {about.differentiators.heading}
    </h2>

    <ul class="about-differentiators">
      {
        about.differentiators.items.map(({ label, body }) => (
          <li class="reveal-on-scroll">
            <h3 class="about-diff-label">{label}</h3>
            <p>{body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 5. Who I work with -->
  <section class="exec-section" aria-labelledby="about-audience">
    <h2 id="about-audience" class="exec-inline-heading reveal-on-scroll">
      {about.audience.heading}
    </h2>

    <p class="about-lead reveal-on-scroll">{about.audience.lead}</p>

    <ul class="exec-bullets">
      {
        about.audience.points.map((point) => (
          <li class="reveal-on-scroll">{point}</li>
        ))
      }
    </ul>
  </section>

  <!-- 6. Engagement types -->
  <section class="exec-section about-engagements" aria-labelledby="about-engagements">
    <h2 id="about-engagements" class="exec-inline-heading reveal-on-scroll">
      {about.engagements.heading}
    </h2>

    <ul class="about-engagement-grid">
      {
        about.engagements.items.map(({ label, body }) => (
          <li class="about-engagement-card reveal-on-scroll">
            <h3 class="about-engagement-label">{label}</h3>
            <p>{body}</p>
          </li>
        ))
      }
    </ul>

    <div class="actions reveal-on-scroll">
      <a class="button primary" href={about.cta.primary.href}>{about.cta.primary.label}</a>
      <a class="button" href={about.cta.secondary.href}>{about.cta.secondary.label}</a>
    </div>
  </section>
  </div>
</BaseLayout>
