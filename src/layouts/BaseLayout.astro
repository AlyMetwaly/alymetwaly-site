---
import { contactMailtoHref, site } from "../config/site";

const { title, description } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { href: "/about", label: "About" },
  { href: "/philosophy", label: "Philosophy" },
  { href: "/work", label: "Work" },
  { href: "/engagements", label: "Engagements" },
  { href: "/insights", label: "Insights" },
  { href: "/interests", label: "Interests" },
] as const;

function navCurrent(href: string) {
  if (href === "/about") return path === "/about" ? "page" : undefined;
  return path === href || path.startsWith(`${href}/`) ? "page" : undefined;
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>

    {description && <meta name="description" content={description} />}

    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>

  <body>
    <header class="site-header">
      <div class="site-title">
        <a href="/">Aly Metwaly</a>
      </div>
      <nav class="site-nav" aria-label="Primary">
        {nav.map(({ href, label }) => (
          <a href={href} aria-current={navCurrent(href)}>
            {label}
          </a>
        ))}
      </nav>
    </header>

    <main class="page-main">
      <div class="surface page-surface">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <span>AI transformation, adoption-first execution, and operating models at enterprise scale.</span>
        {" "}
        <a href={contactMailtoHref}>{site.contactEmail}</a>
        {" · "}
        <a href="/engagements">Engagements</a>
      </div>
    </footer>

    <noscript>
      <style>
        .reveal-on-scroll {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>

    <script is:inline>
      (function () {
        var nodes = document.querySelectorAll(".reveal-on-scroll");
        if (!nodes.length) return;

        var reduced =
          window.matchMedia &&
          window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        if (reduced || !("IntersectionObserver" in window)) {
          nodes.forEach(function (n) {
            n.classList.add("is-visible");
          });
          return;
        }

        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 }
        );

        nodes.forEach(function (n) {
          io.observe(n);
        });
      })();
    </script>
  </body>
</html>
