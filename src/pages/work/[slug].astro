---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("work");
  const published = entries.filter((e) => (import.meta.env.PROD ? !e.data.draft : true));
  return published.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<BaseLayout title={entry.data.title} description={entry.data.description} landing>
  <article class="case-study">
    <header class="case-study-header reveal-on-scroll">
      {entry.data.organization ? (
        <div class="kicker">
          <span class="kicker-dot"></span>
          {entry.data.organization}
          {entry.data.tags?.length ? ` · ${entry.data.tags[0]}` : ""}
        </div>
      ) : null}

      <h1>{entry.data.title}</h1>

      <p class="case-study-hook">{entry.data.hook}</p>
    </header>

    <div class="case-study-body reveal-on-scroll">
      <Content />
    </div>

    <section class="case-impact reveal-on-scroll" aria-labelledby="case-impact-heading">
      <h2 id="case-impact-heading" class="case-impact-heading">Impact</h2>

      <ul class="case-impact-strip">
        {
          entry.data.impactMetrics.map((metric) => (
            <li class="case-impact-metric">
              <span class="case-impact-value">{metric.value}</span>
              <span class="case-impact-label">{metric.label}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="actions reveal-on-scroll">
      <a class="button primary" href="/work">All case studies</a>
      <a class="button" href="/engagements">Discuss an engagement</a>
    </div>
  </article>
</BaseLayout>
