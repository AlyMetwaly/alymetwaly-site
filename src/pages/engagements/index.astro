---
import { executive } from "../../config/executive";
import { contactMailtoHref } from "../../config/site";
import BaseLayout from "../../layouts/BaseLayout.astro";

const { engagements } = executive;
---

<BaseLayout
  title={engagements.meta.title}
  description={engagements.meta.description}
  landing
>
  <div class="exec-landing engagements-doc">
    <!-- 1. Title -->
    <section class="exec-section exec-hero engagements-opening" aria-labelledby="engagements-title">
      <div class="kicker reveal-on-scroll">
        <span class="kicker-dot"></span>
        {engagements.kicker} · {executive.regions}
      </div>

      <h1 id="engagements-title" class="reveal-on-scroll">{engagements.title}</h1>

      {
        engagements.intro.lines.map((line, i) => (
          <p class:list={["reveal-on-scroll", i === 0 && "exec-lead"]}>{line}</p>
        ))
      }
    </section>

    <!-- 2. Types of engagements -->
    <section class="exec-section" aria-labelledby="engagements-types">
      <h2 id="engagements-types" class="exec-inline-heading reveal-on-scroll">
        {engagements.types.heading}
      </h2>

      <ul class="about-engagement-grid">
        {
          engagements.types.items.map(({ label, body }) => (
            <li class="about-engagement-card reveal-on-scroll">
              <h3 class="about-engagement-label">{label}</h3>
              <p>{body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 3. What clients get -->
    <section class="exec-section" aria-labelledby="engagements-outcomes">
      <h2 id="engagements-outcomes" class="exec-inline-heading reveal-on-scroll">
        {engagements.whatClientsGet.heading}
      </h2>

      <ul class="about-differentiators">
        {
          engagements.whatClientsGet.items.map(({ label, body }) => (
            <li class="reveal-on-scroll">
              <h3 class="about-diff-label">{label}</h3>
              <p>{body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 4. Example topics -->
    <section class="exec-section" aria-labelledby="engagements-topics">
      <h2 id="engagements-topics" class="exec-inline-heading reveal-on-scroll">
        {engagements.exampleTopics.heading}
      </h2>

      <ul class="exec-bullets">
        {
          engagements.exampleTopics.items.map((topic) => (
            <li class="reveal-on-scroll">{topic}</li>
          ))
        }
      </ul>
    </section>

    <!-- 5. CTA -->
    <section class="exec-section exec-cta engagements-cta" aria-labelledby="engagements-cta">
      <h2 id="engagements-cta" class="exec-inline-heading reveal-on-scroll">
        {engagements.cta.heading}
      </h2>

      <p class="exec-cta-lead reveal-on-scroll">{engagements.cta.lead}</p>

      <div class="actions reveal-on-scroll">
        <a class="button primary" href={contactMailtoHref}>{engagements.cta.primary.label}</a>
        <a class="button" href={engagements.cta.secondary.href}>
          {engagements.cta.secondary.label}
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
