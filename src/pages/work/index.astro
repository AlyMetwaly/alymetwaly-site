---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const all = await getCollection("work");
const items = all
  .filter((e) => (import.meta.env.PROD ? !e.data.draft : true))
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);
---

<BaseLayout
  title="Case Studies — Aly Metwaly"
  description="Executive case studies: enterprise AI adoption, operating model design, and performance transformation at scale."
  landing
>
  <div class="work-index">
    <header class="work-index-hero">
      <div class="kicker reveal-on-scroll">
        <span class="kicker-dot"></span>
        Selected impact · measurable outcomes
      </div>

      <h1 class="reveal-on-scroll">Case studies</h1>

      <p class="work-index-lead reveal-on-scroll">
        Execution at enterprise scale—operating models, adoption depth, and outcomes
        leadership can defend in a board review.
      </p>
    </header>

    <section aria-labelledby="case-studies-heading">
      <h2 id="case-studies-heading" class="visually-hidden">Case studies</h2>

      {
        items.length > 0 ? (
          <ul class="case-grid work-case-grid">
            {items.map((entry) => (
              <li class="reveal-on-scroll">
                <a class="case-card work-case-card" href={`/work/${entry.slug}`}>
                  {entry.data.organization ? (
                    <span class="work-case-org">{entry.data.organization}</span>
                  ) : null}
                  <h3 class="case-title">{entry.data.title}</h3>
                  <p class="case-desc">{entry.data.hook}</p>
                  <ul class="work-case-metrics" aria-label="Key metrics">
                    {entry.data.previewMetrics.map((metric) => (
                      <li>
                        <span class="work-case-metric-value">{metric.value}</span>
                        <span class="work-case-metric-label">{metric.label}</span>
                      </li>
                    ))}
                  </ul>
                  <span class="work-case-cta">Read case study</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty-hint">
            Published case studies will appear here. Drafts stay local until you mark them ready.
          </p>
        )
      }
    </section>

    <section class="work-index-footer reveal-on-scroll">
      <p>
        I design the operating systems that turn enterprise AI ambition into measurable
        execution—across global engineering organizations, not sandbox pilots.
      </p>

      <div class="actions">
        <a class="button primary" href="/engagements">Discuss an engagement</a>
        <a class="button" href="/insights">Read insights</a>
      </div>
    </section>
  </div>
</BaseLayout>
