---
import { executive } from "../config/executive";
import BaseLayout from "../layouts/BaseLayout.astro";

const { interests } = executive;
---

<BaseLayout title={interests.meta.title} description={interests.meta.description} landing>
  <div class="exec-landing interests-doc">
    <section class="exec-section exec-hero interests-opening" aria-labelledby="interests-title">
      <div class="kicker reveal-on-scroll">
        <span class="kicker-dot"></span>
        {interests.kicker}
      </div>

      <h1 id="interests-title" class="reveal-on-scroll">{interests.title}</h1>

      {
        interests.intro.lines.map((line, i) => (
          <p class:list={["reveal-on-scroll", i === 0 && "exec-lead"]}>{line}</p>
        ))
      }
    </section>

    <section class="exec-section" aria-labelledby="interests-list">
      <h2 id="interests-list" class="visually-hidden">Interests</h2>

      <ul class="interests-items">
        {
          interests.items.map(({ title, line }) => (
            <li class="interests-item reveal-on-scroll">
              <h3 class="interests-item-title">{title}</h3>
              <p class="interests-item-line">{line}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
